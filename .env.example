# Environment Variables

# ================================================
# DATABASE
# ================================================
DATABASE_URL=postgresql+psycopg://lic_agent_user:kaiju@localhost:5432/lic_agent_db
DATABASE_SYNC_URL=postgresql://licagent:licagent_dev@localhost:5432/licagentdb

# ================================================
# REDIS
# ================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ================================================
# JWT SECRETS (Generate strong random values)
# ================================================
JWT_SECRET=change_this_to_a_very_long_random_secret_key_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_key_at_least_64_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================================
# APPLICATION
# ================================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_to_a_long_random_secret_key

# ================================================
# CORS
# ================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================================================
# FRONTEND
# ================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=LIC Agent Platform

# ================================================
# AI PROVIDER
# ================================================
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1

# Alternative: Google Gemini
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-1.5-flash

# Alternative: Anthropic Claude
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-3-haiku-20240307

# ================================================
# FILE STORAGE
# ================================================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# S3-compatible (production)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
# S3_BUCKET=lic-agent-platform

# ================================================
# EMAIL (SMTP)
# ================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_NAME=LIC Agent Platform
SMTP_FROM_EMAIL=noreply@licagent.com
SMTP_USE_TLS=true

# ================================================
# POSTGRESQL (Docker)
# ================================================
POSTGRES_USER=licagent
POSTGRES_PASSWORD=licagent_dev
POSTGRES_DB=licagentdb

# ================================================
# ADMIN SEED
# ================================================
ADMIN_EMAIL=admin@licagent.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

AGENT_EMAIL=agent@licagent.com
AGENT_PASSWORD=Agent@123456
AGENT_FIRST_NAME=LIC
AGENT_LAST_NAME=Agent

# ================================================
# RATE LIMITING
# ================================================
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# ================================================
# LOGGING
# ================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ================================================
# SENTRY (optional)
# ================================================
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
